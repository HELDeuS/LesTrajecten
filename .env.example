# ---- AI-provider: werkt met elke OpenAI-compatibele API (Mistral, vLLM,
# llamapcpp/Ollama (/v1), LM Studio, OpenRouter, etc.) ----
# Voor een private LLM-server bijv.: AI_BASE_URL=http://mijnserver:8000/v1
AI_BASE_URL=https://api.mistral.ai/v1
AI_API_KEY=
AI_MODEL=mistral-large-latest
# Zet op "off" als de server response_format/json_object niet ondersteunt
AI_JSON_MODE=on

# Pdf-extractie: "mistral" (OCR via Mistral, ook voor scans) of "local"
# (lokale tekst-extractie zonder API-sleutel; niet voor gescande pdf's)
AI_PDF_EXTRACT=mistral

# Oudere configuratie (nog steeds ondersteund als AI_* niet is ingesteld):
# MISTRAL_API_KEY= / MISTRAL_MODEL=

# Wachtwoord voor ondertekening van sessies: minimaal 32 willekeurige tekens
AUTH_SECRET=

# Admin-account voor de eerste seed (optioneel)
ADMIN_EMAIL=admin@lestrajecten.local
ADMIN_PASSWORD=

# Poort (standaard 3000)
PORT=3000

# Zet op "true" zodra de app achter HTTPS draait (reverse proxy met TLS).
# Laat op "false" (of weg) bij toegang via http://.
COOKIE_SECURE=false
