# Mistral AI API-sleutel (https://console.mistral.ai/)
MISTRAL_API_KEY=
# Optioneel: modelkeuze (standaard: mistral-large-latest)
MISTRAL_MODEL=mistral-large-latest

# Wachtwoord voor ondertekening van sessies: minimaal 32 willekeurige tekens
AUTH_SECRET=

# Admin-account voor de eerste seed (optioneel)
ADMIN_EMAIL=admin@lestrajecten.local
ADMIN_PASSWORD=

# Poort (standaard 3000)
PORT=3000
